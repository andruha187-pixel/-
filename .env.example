# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

# PAPER — EACH of the 4 strategies gets this amount independently
PAPER_START_BALANCE=500
ORDER_SIZE=10
DECISION_INTERVAL=3
TRADE_WINDOW_SECONDS=180
MIN_FREE_CASH=5
MIN_PRICE=0.08
MAX_PRICE=0.95

# E / V5 DYNAMIC HEDGE
# Start protection after 20 actual shares on E's first actual V5 side.
HEDGE_START_SHARES=20
# Target settlement floor if that primary side loses: -$10.
HEDGE_MAX_LOSS=10
# Do not hedge so much that a primary-side win projects below +$2.
HEDGE_MIN_UPSIDE=2
# Ignore microscopic hedge fills.
HEDGE_MIN_ORDER_SHARES=0.05

# Binance CONF65
BINANCE_SYMBOL=btcusdt
CONF_MIN=65
BINANCE_LARGE_TRADE_USD=50000
BINANCE_SIGNAL_MAX_AGE_MS=1500
REGIME_WINDOW_SEC=30
START_PRICE_CAPTURE_WINDOW_SEC=3

# Exact old V2 confidence weights
W_IMPULSE=22
W_FLOW=18
W_BOOK=14
W_LARGE=8
W_TREND=14
W_DISTANCE=18
W_POLY_PRICE=6

# Feed/runtime safety
BINANCE_NO_TRADE_RECONNECT_MS=5000
MEMORY_KEEP_RESOLVED_SEC=900

# PAPER only.
ENABLE_LIVE=0
