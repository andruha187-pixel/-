# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

# PAPER — EACH of the 6 strategies gets this balance independently
PAPER_START_BALANCE=500
ORDER_SIZE=10
DECISION_INTERVAL=3
TRADE_WINDOW_SECONDS=180
MIN_FREE_CASH=5
MIN_PRICE=0.08
MAX_PRICE=0.95

# E / V5 DYNAMIC HEDGE
HEDGE_START_SHARES=20
HEDGE_MAX_LOSS=10
HEDGE_MIN_UPSIDE=2
HEDGE_MIN_ORDER_SHARES=0.05

# F pair hedge reference target
PAIR_LOCKED_PROFIT=0.25
PAIR_HEDGE_CHECK_INTERVAL=0.20
PAIR_DEFAULT_TICK_SIZE=0.01
PAIR_DEFAULT_MIN_ORDER_SIZE=1
PAIR_LIMIT_FILL_REQUIRE_VISIBLE_SIZE=1

# G / V5 SMART65
SMART_HEDGE_RATIO=0.65
SMART_MAX_LOSS=6
SMART_RISK_START_SHARES=16
SMART_MIN_UPSIDE=1
SMART_RISK_MIN_ORDER_SHARES=0.05

# G actual order size by executed outcome price
SMART_SIZE_1_MAX_PRICE=0.62
SMART_SIZE_1_SHARES=10
SMART_SIZE_2_MAX_PRICE=0.70
SMART_SIZE_2_SHARES=8
SMART_SIZE_3_MAX_PRICE=0.78
SMART_SIZE_3_SHARES=6
SMART_SIZE_4_MAX_PRICE=0.82
SMART_SIZE_4_SHARES=4
# > 0.82 => G skips the actual PAPER buy

# Binance CONF65
BINANCE_SYMBOL=btcusdt
CONF_MIN=65
BINANCE_LARGE_TRADE_USD=50000
BINANCE_SIGNAL_MAX_AGE_MS=1500
REGIME_WINDOW_SEC=30
START_PRICE_CAPTURE_WINDOW_SEC=3
W_IMPULSE=22
W_FLOW=18
W_BOOK=14
W_LARGE=8
W_TREND=14
W_DISTANCE=18
W_POLY_PRICE=6

# Runtime safety
BINANCE_NO_TRADE_RECONNECT_MS=5000
MEMORY_KEEP_RESOLVED_SEC=900

# PAPER only
ENABLE_LIVE=0
