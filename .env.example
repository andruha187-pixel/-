TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO
SYMBOL=BTC

# PAPER account
PAPER_START_BALANCE=500
MIN_FREE_CASH=5

# Strategy — keep fixed for out-of-sample test
DECISION_INTERVAL=3.0
TRADE_WINDOW_SECONDS=180
ORDER_SIZE=10
ENTRY_MOVE=0.03
PYRAMID_STEP=0.08
LOOKBACK_TICKS=2
FIRST_SIGNAL_PRICE_MIN=0.64
FIRST_SIGNAL_PRICE_MAX=0.75
MOMENTUM_CAP=0.30
MAX_BUYS_SIDE=2
MIN_PRICE=0.08
MAX_PRICE=0.95

# Polymarket / reporting
CRYPTO_FEE_RATE=0.07
DISCOVERY_INTERVAL=10
MAX_BOOK_AGE_MS=1000
REPORT_DELAY_SECONDS=300
REPORT_CHECK_INTERVAL=30

# Render stability
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_LOG_INTERVAL=300
